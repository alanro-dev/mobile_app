# Copy this file to .env and fill in your real values. Never commit .env.

PORT=3000

# --- Neon database connection ---
# RECOMMENDED: use these discrete fields instead of a single DATABASE_URL.
# This avoids a common gotcha: Neon-generated passwords can contain special
# characters (@ # % / : etc.) which break URL parsing if embedded in a single
# connection-string. Passed here as plain fields, no encoding needed.
#
# Get these from your Neon dashboard: Project > Connect. The connection
# string shown there looks like:
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Map it to the fields below (HOST is everything between @ and the first /):
PGHOST=ep-royal-fire-ay7iix3b-pooler.c-5.us-east-2.aws.neon.tech
PGPORT=5432
PGUSER=neondb_owner
PGPASSWORD=your_neon_password_here
PGDATABASE=neondb
PGSSLMODE=require

# --- Alternative: single connection string ---
# Only use this if you'd rather not split it into fields above. If your
# password has special characters, they must be percent-encoded
# (e.g. "@" -> "%40", "#" -> "%23", "%" -> "%25", "/" -> "%2F").
# DATABASE_URL=postgresql://<user>:<password>@<ep-id>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require

# Use a long random string in production, e.g: openssl rand -hex 64
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API.
# Ionic serve default is http://localhost:8100
CORS_ORIGIN=http://localhost:8100
