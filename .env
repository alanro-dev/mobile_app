# Copy this file to .env and fill in your real values. Never commit .env.

PORT=3000

# From your Neon dashboard: Project > Connect > copy the "Connection string".
# Neon requires SSL, and its connection strings already include ?sslmode=require —
# leave that on the end, pool.js checks for it to enable SSL automatically.
#
# Neon gives you two host variants:
#   ep-xxxx-pooler.<region>.aws.neon.tech   <- pooled (recommended, use this one)
#   ep-xxxx.<region>.aws.neon.tech          <- direct (only needed for things like migrations tools that don't support pooling)
# For this app (a normal long-running Express server), the pooled connection is fine.
DATABASE_URL=postgresql://neondb_owner:npg_mIlZanP4Bj0f@ep-raspy-sun-a5d8m68a-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Use a long random string in production, e.g: openssl rand -hex 64
JWT_SECRET=70ab6c987fbc44617c8cf63f7e986d5d2937875a92e2eaeaccade1670fe5b2dda46556db3673cdad5f0cae22f690efba43807c349b90b8dcd28667a22e623f61
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API.
# Ionic serve default is http://localhost:8100
CORS_ORIGIN=http://localhost:8100
